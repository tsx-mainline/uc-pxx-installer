#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# PID 1 of the installer RAM image. It mounts the kernel file systems and
# starts busybox init (/etc/inittab). The image runs only from RAM. It never
# mounts an eMMC file system and never writes to the eMMC: /etc/init.d/rcS
# sets the kernel read-only flag of every eMMC device first.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755,nodev,nosuid run /run
mount -t tmpfs -o mode=1777,nodev,nosuid tmp /tmp
mount -t configfs configfs /sys/kernel/config
mkdir -p /run/p10inst
echo "p10inst-init: kernel $(uname -r), busybox init next" > /dev/kmsg
exec /sbin/init
