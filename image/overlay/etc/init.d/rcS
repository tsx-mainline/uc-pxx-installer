#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Start of the installer RAM image (busybox init runs it once).
#
#   1. Wait for the eMMC, then set the kernel read-only flag on the disk and
#      on every partition (p10inst readonly). After this the kernel refuses
#      every write and every read-write mount. This changes no byte on the
#      eMMC.
#   2. The screen: the Terminus font of the model on tty1 (16x32 on the UC-P10,
#      12x24 on the UC-P8), the backlight at 50 %.
#   3. The drive: a FAT file in RAM (tmpfs), label P10-INSTALL.
#   4. The USB gadget (p10inst usbd): serial shell, network, drive.
# Nothing starts on eth0.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG=/run/p10inst/p10inst.log
log() {
	echo "p10inst-rcS: $*" > /dev/kmsg 2>/dev/null
	echo "$(date +%H:%M:%S) $*" >> $LOG
}
mkdir -p /run/p10inst
hostname p10inst
ip link set lo up

# the kernel command line: p10inst.drive_mb=N (size of the drive, 0 = none)
DRIVE_MB=1200
for w in $(cat /proc/cmdline); do
	case $w in
	p10inst.drive_mb=*) DRIVE_MB=${w#p10inst.drive_mb=} ;;
	esac
done
case $DRIVE_MB in ''|*[!0-9]*) DRIVE_MB=1200 ;; esac

# 1. read-only eMMC
i=0
while [ ! -b /dev/mmcblk0 ] && [ $i -lt 60 ]; do sleep 0.25; i=$((i + 1)); done
sleep 0.5
if out=$(p10inst readonly 2>&1); then
	log "eMMC $out"
else
	log "eMMC read-only flag FAILED: $out"
fi

# 2. screen
# The font for the panel of this image's model (its device tree, UC-P8.md 5.2):
# UC-P10 1920x1200 ter-132b (120 x 37 cells), UC-P8 1280x800 ter-124b (106 x 33).
FONT=ter-132b
case " $(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null) " in
*" crestron,uc-p8 "*) FONT=ter-124b ;;
esac
setfont -C /dev/tty1 /usr/share/consolefonts/$FONT.psf 2>/dev/null && log "font $FONT on tty1"
for b in /sys/class/backlight/*; do
	[ -r "$b/max_brightness" ] || continue
	m=$(cat "$b/max_brightness")
	echo $((m / 2)) > "$b/brightness" 2>/dev/null && log "backlight $((m / 2)) of $m"
done
# The blue LED blinks until the status is read (the device tree trigger).
if [ -w /sys/class/leds/blue/delay_on ]; then
	echo 250 > /sys/class/leds/blue/delay_on
	echo 250 > /sys/class/leds/blue/delay_off
fi

# 3. the drive (RAM only)
DRIVE=
if [ "$DRIVE_MB" -gt 0 ]; then
	D=/run/p10inst/drive
	mkdir -p $D
	if mount -t tmpfs -o size=$((DRIVE_MB + 8))m,mode=0700 drive $D &&
		truncate -s ${DRIVE_MB}M $D/drive.img &&
		mkfs.vfat -n P10-INSTALL $D/drive.img > /dev/null 2>&1; then
		DRIVE=$D/drive.img
		log "drive P10-INSTALL: ${DRIVE_MB} MiB in RAM"
	else
		log "drive: cannot make the RAM drive"
	fi
fi

# 4. USB gadget
if [ -n "$DRIVE" ]; then
	p10inst usbd --drive "$DRIVE" > /dev/null 2>&1 &
else
	p10inst usbd > /dev/null 2>&1 &
fi
log "usbd started"
exit 0
