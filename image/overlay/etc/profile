# The shells of the installer RAM image (serial, USB serial, ssh).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PS1='uc-pxx-inst# '
cat <<'EOF'
UC-P10 installer (RAM image, read-only). Nothing here writes to the eMMC.
  uc-pxx-inst status        the status of both slots
  uc-pxx-inst ui --stdin    the screen UI on this terminal
  reboot                leave the installer (the A/B metadata picks the slot)
Logs: /run/uc-pxx-inst/uc-pxx-inst.log, dmesg
If the installer crashes, the unit restarts into fastboot after 30 s:
start the installer again, or disconnect the power.
EOF
