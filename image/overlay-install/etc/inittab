# busybox init of the INSTALL RAM image (image/build.sh --install). It is the
# inittab of the status image (image/overlay/etc/inittab) with one change: the
# screen runs the on-screen install flow in place of the status UI.
::sysinit:/etc/init.d/rcS
# The screen: the install flow, driven by the touch keys. The flow itself
# writes nothing to the eMMC. Only after OK is held for 3 s on the plan screen
# does it start the device mode (p10inst install --device /dev/mmcblk0 ...)
# as a supervised child.
tty1::respawn:/usr/bin/p10inst flow --leds
# A root shell on the debug UART (ttyS2, 115200). Only a person with the
# debug cable reaches it.
::respawn:/bin/sh -c "[ -c /dev/ttyS2 ] && exec /sbin/getty -n -l /bin/sh -L 115200 ttyS2 vt100 || exec sleep 2147483647"
# A root shell on the USB serial port (CDC-ACM, ttyGS0). The device exists
# when usbd has made the gadget.
::respawn:/bin/sh -c "while [ ! -c /dev/ttyGS0 ]; do sleep 1; done; exec /sbin/getty -n -l /bin/sh -L 115200 ttyGS0 vt100"
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync
