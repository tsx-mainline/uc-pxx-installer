# The shells of the INSTALL RAM image (serial, USB serial, ssh).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PS1='uc-pxx-inst-INSTALL# '
# the model of this image (one cpio for the UC-P10 and the UC-P8): its device tree
M=$(tr -d '\000' 2>/dev/null < /proc/device-tree/model)
M=${M#Crestron }
case $M in UC-P10|UC-P8) ;; *) M=UC-P10/UC-P8 ;; esac
cat <<TXT
$M installer, INSTALL image (RAM image). This image CAN WRITE the eMMC:
the install on the screen writes one slot after OK is held for 3 s on the
plan screen. Do not run eMMC tools by hand, and do not restart, while an
install runs. The screen says when it is safe to disconnect the power.
  uc-pxx-inst status        the status of both slots (reads only)
  reboot                leave the installer (only when no install runs)
Logs: /run/uc-pxx-inst/uc-pxx-inst.log, /run/uc-pxx-inst/flow/flow.log, dmesg
If the installer crashes, the unit restarts into fastboot after 30 s.
TXT
unset M
