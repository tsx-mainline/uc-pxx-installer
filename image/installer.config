# SPDX-License-Identifier: GPL-2.0-or-later
# Kernel config fragment of the installer RAM image, on top of
#   make defconfig uc-pxx.config
# (uc-pxx.config is in the uc-pxx kernel branch). The installer needs the
# display, the touch keys, the LEDs, the eMMC and the USB gadget. It drops
# the drivers that it does not need: fewer drivers, less risk.

# --- not needed: GPU, video codecs, 2D ---
# CONFIG_DRM_PANFROST is not set
# CONFIG_VIDEO_HANTRO is not set
# CONFIG_VIDEO_ROCKCHIP_VDEC is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set

# --- not needed: audio ---
# CONFIG_SOUND is not set

# --- not needed: Wi-Fi and Bluetooth ---
# CONFIG_BT is not set
# CONFIG_BRCMFMAC is not set
# CONFIG_MAC80211 is not set
# CONFIG_CFG80211 is not set

# --- the console font of the screen, if setfont fails ---
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
