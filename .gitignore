# Crestron firmware, partition images and vendor files never go into the repo
*.pcdfw
pcdfw-*.bin
*.img
*.puf
libwebupdate.so
libprovdetect.so

# key files never go into the repo
*keys*.txt

# build output
/p10inst
/p10inst-*
/out/
web/site/images/
# the unlock client is a release asset, bundled by the Pages workflow (like the
# install image); the one-liner scripts (*.sh, *.ps1) are tracked.
web/site/tools/*.android-arm64
# the reproducible build output of tools/tee-unlock
tools/tee-unlock/out/
__pycache__/
web/test/node_modules
