#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""p10-enter: bring a UC-P10 from its running OS into U-Boot fastboot, then
RAM-boot an installer image with `fastboot boot`.

NOT FOR USE ON A UNIT until the Opus review that P10-ENTER.md asks for and the
owner's approval. The rockusb route writes the misc BCB (a rule-9 write).

  p10-enter ssh --target USER@HOST --image IMG --sha256 HEX --expect-serialno S [options]
      The unit runs mainline. Read only over ssh: the restart block and the
      tsx-autoupdate fields (no install, no hold), and LBA 49156 (dd, decoded
      here: the next slot must be successful). Then `/usr/sbin/uc-pxx-reboot
      fastboot` (the register route, it writes nothing). The tool writes
      nothing to the unit.

  p10-enter rockusb --image IMG --sha256 HEX --expect-serialno S
                    --bcb-go HEX --expect-ab-sha256 HEX --go-file FILE [options]
      The unit is in the stock download mode (rockusb). The tool reads the A/B
      sector (LBA 49156, read only; both slots must be successful and its first
      32 bytes must have the given sha256) and the BCB (LBA 49184, 4 sectors),
      writes the BCB command "bootonce-bootloader" only from a known BCB state,
      reads it back, resets the unit and waits for fastboot.

  p10-enter dump [--log-dir DIR]
      Read only. The unit is in the download mode. Saves the A/B sector and
      the BCB, prints their sha256 and if the BCB is a known state.

Then (ssh, rockusb): the fastboot serial and `getvar serialno` must be the
given one; single getvars (never `getvar all`) must give the same A/B state as
the sector read before; `fastboot boot` of a checked copy of the image.

Guards (see P10-ENTER.md): LBA 49156 is only read; every command is checked at
the one place where programs start (Runner.check_exec); no timeout or kill of
any device command; SIGINT, SIGTERM, SIGHUP and SIGQUIT are held to the next
safe point; the log file is written before the terminal, and a dead terminal
does not stop the sequence; Maskrom = stop; --dry-run runs no program.
"""

import argparse
import hashlib
import json
import math
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time
import zlib

# ---------------------------------------------------------------- constants
SECTOR = 512
AB_LBA = 49156            # AvbABData in misc (49152 + 4). READ ONLY. Never written.
BCB_LBA = 49184           # misc + 16 KiB, where U-Boot reads the BCB (4 blocks)
BCB_SECTORS = 4
BCB_SIZE = BCB_SECTORS * SECTOR
BCB_COMMAND = b"bootonce-bootloader"
# sha256 of BCB_COMMAND padded with zero bytes to 2048 bytes. The same bytes
# as ucp10/tools/p10-bcb-fastboot.sh writes (misc-bcb4-bootloader.bin).
BCB_PAYLOAD_SHA256 = "892627cb4356d1d16c37bf243d700b5c9a0ab672d263de9ccd640c86b5cd6a5a"
STATES_FILE = "bcb-known-states.json"
# The known-state file is pinned: a new state needs a change here and a review.
STATES_SHA256 = "ed0824f2aabe4fe71860c900e8323ecba24de562d14091ff88e9a999ce2f00ac"

# The fixed remote commands of the ssh route. Nothing else is sent over ssh.
REBOOT_CMD = "/usr/sbin/uc-pxx-reboot fastboot"
REBOOT_DRY_CMD = "/usr/sbin/uc-pxx-reboot --dry-run fastboot"
REBOOT_DRY_OK = "with the argument 'fastboot'"
# The interlock of tsx-autoupdate and tsx-panelctl, read without a tool:
#   - no tsx-autoupdate run: the test of tsx-panelctl restart_block(),
#     `flock -n /run/tsx/autoupdate.lock true`. A run (now, the tick,
#     post-update) holds an exclusive flock on that file for its whole time,
#     from tsx_board_pre_update (uc-pxx-arm-slot) on. The test takes the lock
#     only if it is free and drops it when `true` ends, before the next line;
#     it never holds it across the restart. Only when the file exists (no file
#     = no run since boot), so nothing is created. flock missing = refused;
#   - the restart block absent;
#   - the fields of tsx-autoupdate present, in_progress empty or 0 and
#     post_update empty (no install, no hold, no retry, no owed step).
# The same files that tsx-panelctl restart_block() and tsx-autoupdate
# run_locked() and write_restart_block() use.
LOCK_FILE = "/run/tsx/autoupdate.lock"
STATE_CHECK_CMD = (
    "p=$(command -v flock); "
    "if [ -z \"$p\" ]; then echo 'flock missing'; "
    "elif [ ! -e /run/tsx/autoupdate.lock ]; then echo 'lock absent'; "
    "elif flock -n /run/tsx/autoupdate.lock true; then echo 'lock free'; "
    "else echo 'lock held'; fi; "
    "if [ -e /run/tsx/restart-block ]; then "
    "echo \"restart-block present: $(head -n 1 /run/tsx/restart-block)\"; "
    "else echo 'restart-block absent'; fi; "
    "f=/var/lib/tsx/autoupdate/fields; "
    "if [ -e \"$f\" ]; then echo 'fields present'; grep -E '^(in_progress|post_update)( |$)' \"$f\"; "
    "else echo 'fields absent'; fi; "
    "echo 'check end'")
AB_READ_CMD = "dd if=/dev/mmcblk0 bs=%d skip=%d count=1" % (SECTOR, AB_LBA)
REMOTE_CMDS = (STATE_CHECK_CMD, AB_READ_CMD, REBOOT_DRY_CMD, REBOOT_CMD)
SSH_DEFAULT_OPTS = ("ServerAliveInterval=5", "ServerAliveCountMax=6", "ConnectTimeout=15")

# fastboot getvars, one at a time. REQUIRED: must be read; the slot vars must
# match the A/B sector read before the entry.
SLOT_VARS = ("current-slot", "slot-successful:a", "slot-successful:b", "slot-unbootable:a",
             "slot-unbootable:b", "slot-retry-count:a", "slot-retry-count:b")
REQUIRED_VARS = ("serialno",) + SLOT_VARS
INFO_VARS = ("variant", "product")
GETVARS = REQUIRED_VARS + INFO_VARS

# Files that rkdeveloptool rl may write, in the log folder.
READ_FILES = ("ab-before.bin", "bcb-before.bin", "bcb-guard.bin", "bcb-after.bin",
              "ab-after-write.bin", "ab.bin", "bcb.bin")
PAYLOAD_FILE = "bcb-payload.bin"
BOOT_FILE = "boot.img"

